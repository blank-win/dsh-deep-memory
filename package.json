{
  "name": "dsh-deep-memory",
  "displayName": "深度记忆",
  "version": "0.4.0",
  "private": false,
  "description": "DSH 可移植记忆库：记忆文件、原话留底、认识层、工作区交接、跨机器搬家包",
  "type": "module",
  "main": "./index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blank-win/dsh-deep-memory.git"
  },
  "homepage": "https://github.com/blank-win/dsh-deep-memory#readme",
  "bugs": {
    "url": "https://github.com/blank-win/dsh-deep-memory/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client-simple.js"
  },
  "files": [
    "index.js",
    "workspaces.js",
    "client-simple.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "lib/diary.mjs",
    "lib/library-migrate.mjs",
    "lib/library-template.mjs",
    "lib/memory-core.mjs",
    "lib/memory-sync.mjs",
    "lib/wiki.mjs",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "memory",
    "plugin"
  ],
  "license": "MIT",
  "scripts": {
    "memory-card": "node scripts/make-memory-card.mjs"
  }
}
